{
  "$schema": "https://opencode.ai/config.json",
  // Repo-local OpenCode settings for niri-center.
  // AGENTS.md (auto-loaded as project instructions) says how claims are
  // justified; CONTRIBUTING.md holds the code rules and docs/ADR-*.md the
  // decisions (lossless edits, writes through the disk actor, sandbox on,
  // `niri validate` as dialect oracle).

  // Build artifacts and tool data should never trigger watcher reactions.
  "watcher": {
    "ignore": ["target/**", ".claude/**"],
  },

  // Format Rust sources with rustfmt after write/edit/patch.
  "formatter": true,

  // Smooth contributor flow: the project's own gates (just, cargo) and
  // read-only git commands run freely; pushing stays a deliberate act.
  "permissions": [
    { "action": "shell", "resource": "just *", "effect": "allow" },
    { "action": "shell", "resource": "cargo *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],

  // Repo-specific slash commands — thin wrappers over the justfile gates.
  "commands": {
    "check": {
      "description": "Run the full project gate (fmt + clippy + tests)",
      "template": "Run the project gate via `just check` without changing anything. Report pass/fail per step with the relevant output for anything failing."
    },
    "audit": {
      "description": "Run supply-chain checks (rustsec + cargo-deny)",
      "template": "Run `just audit`, then summarize any advisory, license, ban, or source findings. Do not fix anything unless asked."
    },
    "run": {
      "description": "Build and launch the settings GUI",
      "template": "Build and start the app with `just run`. If it fails to launch, report the error and exit code."
    },
    "licenses": {
      "description": "Regenerate the third-party license report",
      "template": "Regenerate THIRD_PARTY_LICENSES.md with `just licenses` and sanity-check that the diff only reflects dependency changes."
    }
  }
}